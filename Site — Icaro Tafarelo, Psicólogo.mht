#loading.slow { text-align: center; color: var(--mut); flex-direction: column; gap: 12px; padding: 0px 24px; font-size: 13px; }

#loading.slow > button { order: 1; }

#loading::after { content: ""; box-sizing: border-box; background: conic-gradient(transparent 40%, var(--spin)) border-box, linear-gradient(var(--line), var(--line)) border-box; border: 2px solid rgba(0, 0, 0, 0); border-radius: 50%; width: 20px; height: 20px; animation: 1s linear 0s infinite normal none running spin; mask: radial-gradient(farthest-side, rgba(0, 0, 0, 0) calc(100% - 2px), rgb(0, 0, 0) calc(100% - 1.5px)); }

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

#frame-content { opacity: 0.001; border: 0px; width: 100%; height: 100%; transition: opacity 1ms; position: absolute; inset: 0px; }

#frame-slot > iframe { user-select: none; }

#frame-slot > iframe.swap:not(.ready) { opacity: 0.001; pointer-events: none; border: 0px; width: 100%; height: 100%; position: absolute; inset: 0px; }

#frame-slot > iframe.swap.hot-under:not(.ready) { opacity: 1; }

#frame-slot > iframe.hot-under ~ #frame-content { background: var(--bg); }

@supports (background:color-mix(in srgb, red 50%, transparent)) {
  #frame-slot > iframe.hot-under ~ #frame-content { background: color-mix(in srgb, var(--bg) 99.6%, transparent); }
